# HireSense AI Environment Configuration

# Database
# Default local SQLite:
DATABASE_URL=sqlite:///./hiresense.db
# PostgreSQL for production / Docker:
# DATABASE_URL=postgresql://hiresense:hiresense_secret@localhost:5432/hiresense_db

# AI / ML Model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
USE_GPU=false

# Docker Compose PostgreSQL Settings
POSTGRES_USER=hiresense
POSTGRES_PASSWORD=hiresense_secret
POSTGRES_DB=hiresense_db
